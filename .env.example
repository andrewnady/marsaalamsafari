# --- Public site configuration ---
NEXT_PUBLIC_SITE_URL=https://marsaalamsafari.com
NEXT_PUBLIC_SITE_NAME="Marsa Alam Safari"

# --- Contact / booking channels ---
NEXT_PUBLIC_WHATSAPP_NUMBER=201000000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@marsaalamsafari.com
NEXT_PUBLIC_CONTACT_PHONE=+201000000000

# --- Analytics (privacy-friendly; leave blank to disable) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Search Console / verification ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Server-only secrets (booking + contact form backend) ---
CONTACT_INBOX_EMAIL=bookings@marsaalamsafari.com
RESEND_API_KEY=
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# --- Database (Neon serverless Postgres) ---
# Pooled connection string from the Neon dashboard. Persists contact/booking
# inquiries and newsletter subscribers. Leave blank to run without a DB.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
